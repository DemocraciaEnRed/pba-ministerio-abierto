{
  "name": "pba-ministerio-abierto",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "bash -lc 'FILES=$(git diff --name-only --diff-filter=ACMRTUXB HEAD | rg \"\\.(js|cjs|mjs|ts|tsx|vue)$\" || true); if [ -z \"$FILES\" ]; then echo \"No hay archivos JS/TS/Vue cambiados para lint\"; exit 0; fi; eslint $FILES'",
    "typecheck": "nuxt typecheck",
    "icons:optimize": "svgo --config=svgo.config.js --multipass --recursive --folder app/assets/icons",
    "icons:optimize:pba": "svgo --config=svgo.config.js --multipass --folder app/assets/icons/pba",
    "icons:optimize:der": "svgo --config=svgo.config.js --multipass --folder app/assets/icons/der",
    "verify": "pnpm typecheck && pnpm lint && pnpm build",
    "seo:export": "tsx scripts/export-seo.ts",
    "verify:changed": "pnpm typecheck && pnpm lint:changed && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "DATABASE_URL=${DATABASE_MIGRATION_URL:-$DATABASE_URL} prisma migrate dev",
    "db:deploy": "DATABASE_URL=${DATABASE_MIGRATION_URL:-$DATABASE_URL} prisma migrate deploy",
    "db:deploy:remote": "bash scripts/deploy-db.sh",
    "db:seed": "prisma db seed",
    "db:seed:base": "prisma db seed -- --profile base",
    "db:seed:institution": "prisma db seed -- --profile institution",
    "db:seed:regions": "prisma db seed -- --profile regions",
    "db:seed:agenda": "prisma db seed -- --profile regional-meetings",
    "db:seed:metricas": "prisma db seed -- --profile regional-meetings-metrics",
    "db:seed:testimonials": "prisma db seed -- --profile regional-meetings-testimonials",
    "db:seed:demo": "prisma db seed -- --profile demo",
    "db:seed:all": "prisma db seed -- --profile base,institution,regions,regional-meetings-metrics,regional-meetings-testimonials,demo,regional-meetings",
    "db:studio": "prisma studio",
    "db:test": "tsx scripts/test-database.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:setup": "tsx scripts/setup-test-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@iconify-json/lucide": "^1.2.145",
    "@internationalized/date": "^3.12.4",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-youtube": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^3.23.0",
    "marked": "^18.1.1",
    "mrmime": "^2.0.1",
    "nodemailer": "^9.1.1",
    "nunjucks": "^3.2.4",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "nuxt-qrcode": "^0.4.10",
    "tailwindcss": "^4.3.3",
    "vue-advanced-cropper": "^2.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@adonisjs/hash": "9.1.1",
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/nunjucks": "^3.2.6",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^20.14.3",
    "playwright-core": "^1.64.1",
    "prisma": "^7.10.1",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@11.5.0"
}
