/// Carácter en que participa la persona inscripta.
enum RegistrationParticipantCharacter {
  individual
  legal_entity
}

/// Forma de participación. Solo aplica a las audiencias públicas; en las
/// consultas públicas queda en null.
enum RegistrationParticipationMode {
  attendee
  speaker_request
  speaker_report
}

/// Formulario de inscripción presencial de una audiencia o consulta pública.
/// Hay a lo sumo uno por consulta y solo se puede crear en los tipos que lo
/// habilitan (ver `registrationFormKind` en shared/data/consultation-types.ts).
model ConsultationRegistrationForm {
  id             Int      @id @default(autoincrement())
  consultationId Int      @unique
  title          String
  /// Cuerpo con formato (markdown) que se muestra en la página de inscripción.
  body           String?  @db.Text
  /// Fecha y hora en que se realiza la audiencia/consulta.
  eventAt        DateTime
  /// Ventana de inscripción.
  opensAt        DateTime
  closesAt       DateTime
  venueName      String
  venueAddress   String
  venueCity      String
  venueProvince  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation  Consultation               @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  registrations ConsultationRegistration[]
  accreditation Accreditation?

  @@index([opensAt, closesAt])
}

/// Inscripción de una persona a una audiencia/consulta pública. El formulario es
/// público: `userId` solo se completa cuando hay sesión, y en ese caso el índice
/// único impide inscribirse dos veces (MySQL admite múltiples NULL).
model ConsultationRegistration {
  id                  Int      @id @default(autoincrement())
  formId              Int
  userId              Int?
  firstName           String
  lastName            String
  dni                 String
  email               String
  phone               String
  character           RegistrationParticipantCharacter @default(individual)
  /// Bloque de persona jurídica: solo se completa cuando `character` es `legal_entity`.
  entityName          String?
  entityAddress       String?
  entityEmail         String?
  entityPhone         String?
  /// Instrumento que acredita la personería: archivo adjunto o enlace externo.
  proofAssetId        Int?
  proofUrl            String?  @db.VarChar(500)
  participationMode   RegistrationParticipationMode?
  presentationSummary String?  @db.Text
  documentationDetail String?  @db.Text
  createdAt           DateTime @default(now())

  form      ConsultationRegistrationForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User?                              @relation("ConsultationRegistrationUser", fields: [userId], references: [id], onDelete: SetNull)
  proofAsset Asset?                            @relation("ConsultationRegistrationProof", fields: [proofAssetId], references: [id], onDelete: SetNull)
  questions ConsultationRegistrationQuestion[]
  accreditationEntries AccreditationEntry[]    @relation("AccreditationEntryRegistration")

  @@unique([formId, userId])
  @@index([formId, createdAt])
  @@index([email])
}

/// Preguntas que el/la expositor/a formula al inscribirse.
model ConsultationRegistrationQuestion {
  id             Int      @id @default(autoincrement())
  registrationId Int
  body           String   @db.Text
  displayOrder   Int      @default(0)

  registration ConsultationRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, displayOrder])
}

/// Configuración del workflow de acreditaciones de un formulario de inscripción.
/// Es opcional y 1:1 con el formulario. Cuando existe habilita el ingreso de
/// asistentes mediante un QR público durante la ventana `opensAt`–`closesAt`.
model Accreditation {
  id        Int      @id @default(autoincrement())
  formId    Int      @unique
  /// Identificador público corto (8 caracteres alfanuméricos en minúsculas) usado
  /// en la URL del QR; independiente del id interno para no ser predecible.
  publicId  String   @unique @db.VarChar(16)
  /// `false` la conserva como histórica: el QR público queda inhabilitado pero se
  /// preservan los ingresos ya registrados.
  enabled   Boolean  @default(true)
  /// Ventana de acreditación (check-in).
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form    ConsultationRegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  entries AccreditationEntry[]

  @@index([opensAt, closesAt])
}

/// Cada ingreso registrado en una acreditación. El DNI se guarda tal como se
/// ingresa (sin normalizar) y se admiten repetidos: no hay unicidad. `registrationId`
/// vincula el ingreso a una inscripción del mismo formulario cuando el DNI coincide.
model AccreditationEntry {
  id              Int      @id @default(autoincrement())
  accreditationId Int
  registrationId  Int?
  dni             String
  firstName       String?
  lastName        String?
  email           String?
  accreditedAt    DateTime @default(now())

  accreditation Accreditation             @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  registration  ConsultationRegistration? @relation("AccreditationEntryRegistration", fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([accreditationId, accreditedAt])
  @@index([registrationId])
}
