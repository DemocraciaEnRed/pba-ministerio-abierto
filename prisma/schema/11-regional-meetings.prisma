/// Datos de agenda de un Encuentro Regional. Es 1:1 con la consulta de tipo
/// `encuentros-regionales`: se carga en el mismo formulario de alta/edición de
/// la consulta. La región vive en `Consultation.regionId`, el estado se deriva
/// de las fechas de la consulta y el año (para los tabs de la agenda) de `heldAt`.
model RegionalMeetingAgendaItem {
  id             Int      @id @default(autoincrement())
  consultationId Int      @unique
  /// Lugar del encuentro: texto libre (no un municipio del catálogo cerrado).
  location       String
  /// Fecha y hora del encuentro presencial.
  heldAt         DateTime
  /// Destino del botón "Inscribite" (formulario externo). Si es null no hay inscripción.
  registrationUrl      String?   @db.VarChar(500)
  /// Ventana en la que se muestra el botón "Inscribite". Obligatoria si hay URL.
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([heldAt])
}

/// Métrica de alcance de los Encuentros Regionales. Catálogo fijo (4): se
/// siembra y se edita (etiqueta/valor), pero no se crea ni elimina desde la app.
/// `value` es texto para admitir formatos como "1.050" o "+40".
model RegionalMeetingMetric {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  label        String
  value        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

/// Grupo de testimonios ("encuentro" a fines editoriales). ABM completo desde el
/// panel. Puede asociarse opcionalmente a una región para tematizar color/título.
/// Contiene a lo sumo 3 testimonios (regla de negocio validada en el handler).
model RegionalMeetingTestimonialGroup {
  id           Int      @id @default(autoincrement())
  name         String
  municipality String
  heldAt       DateTime
  regionId     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  region       Region?                      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  testimonials RegionalMeetingTestimonial[]

  @@index([regionId])
}

/// Testimonio individual de un participante. Pertenece a un grupo (máximo 3 por
/// grupo). Se crea/edita/elimina como parte del grupo.
model RegionalMeetingTestimonial {
  id           Int      @id @default(autoincrement())
  groupId      Int
  body         String   @db.Text
  authorName   String
  municipality String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group RegionalMeetingTestimonialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, displayOrder])
}

/// Aporte ciudadano al Plan Estratégico de Infraestructura, enviado desde el
/// formulario público de Encuentros Regionales (sin login). Solo se crea vía el
/// POST público; toda lectura es exclusiva de platform-admin (no hay vista
/// pública que liste ni exponga los aportes). Es inmutable: no se edita ni borra.
model RegionalMeetingSubmission {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String
  phone        String
  provincia    String
  municipio    String?
  /// Institución u organización que representa (opcional). El "¿representás una
  /// institución?" del formulario se deriva de este campo (no se persiste el flag).
  organization String?
  /// Selección del eje temático (árbol hardcodeado en el front, guardado como
  /// texto legible). `ejeTematico` es el eje padre; `subejeTematico` el sub-eje.
  ejeTematico    String
  subejeTematico String?
  ideaProyecto String?  @db.Text
  comentarios  String?  @db.Text
  createdAt    DateTime @default(now())

  /// Archivos adjuntos opcionales (hasta 3, 30 MB en total). Se sirven solo a
  /// platform-admin mediante un endpoint protegido, nunca por URL pública.
  attachments     RegionalMeetingSubmissionAttachment[]
  links           RegionalMeetingSubmissionLink[]

  @@index([createdAt])
  @@index([email])
}

/// Archivo adjunto de un aporte de Encuentros Regionales.
model RegionalMeetingSubmissionAttachment {
  id           Int      @id @default(autoincrement())
  submissionId Int
  assetId      Int
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  submission RegionalMeetingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  asset      Asset                     @relation("RegionalMeetingSubmissionAttachmentAsset", fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([submissionId, assetId])
  @@index([submissionId, displayOrder])
  @@index([assetId])
}

/// Enlace en la nube asociado a un aporte (texto libre para archivos que la
/// ciudadanía comparte por URL). El orden no importa: se listan como llegan.
model RegionalMeetingSubmissionLink {
  id           Int      @id @default(autoincrement())
  submissionId Int
  url          String   @db.Text
  title        String?
  createdAt    DateTime @default(now())

  submission RegionalMeetingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
