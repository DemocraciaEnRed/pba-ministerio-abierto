enum ConsultationFormat {
  single
  multiple
}

/// Visibilidad manual de una consulta o tema. El estado temporal
/// (programada/abierta/cerrada) se deriva de las fechas, no se almacena.
enum Visibility {
  hidden
  visible
  archived
}

enum ResultsVisibility {
  hidden
  participants_only
  public
}

model Consultation {
  id                  Int       @id @default(autoincrement())
  /// Nombre legible de la URL pública (`/{seccion}/{id}/{slug}`). No es único:
  /// la instancia se identifica por `id`.
  slug                String
  title               String
  summary             String?   @db.Text
  body                String?   @db.Text
  consultationFormat  ConsultationFormat @default(single)
  visibility          Visibility @default(hidden)
  featured            Boolean   @default(false)
  startsAt            DateTime
  endsAt              DateTime?
  publishedAt         DateTime?
  closedMessage       String?   @db.Text
  /// Cuando es `false` la sección de comentarios se oculta y se deshabilita comentar y reaccionar.
  commentsEnabled     Boolean   @default(true)
  /// Texto opcional (Markdown) que orienta la conversación debajo del título "Comentarios".
  commentsGuidance    String?   @db.Text
  resultsVisibility   ResultsVisibility @default(hidden)
  sectionId           Int?
  regionId            Int?
  createdByUserId     Int?
  updatedByUserId     Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdBy User? @relation("ConsultationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ConsultationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  region    Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  workGroupAssignments ConsultationObservatoryWorkGroup[]
  topics    Topic[]
  memberships ConsultationMembership[]
  categoryAssignments ConsultationCategoryAssignment[]
  consultationTags ConsultationTag[]
  closure ConsultationClosure?
  comments Comment[]
  relatedLinks ConsultationRelatedLink[]
  registrationForm ConsultationRegistrationForm?
  regionalMeeting  RegionalMeetingAgendaItem?
  legacySlugs ConsultationLegacySlug[]
  dataExports DataExport[]

  @@index([visibility])
  @@index([featured])
  @@index([startsAt, endsAt])
  @@index([regionId])
  @@index([sectionId])
}

/// Slugs del formato anterior (`/consultas/{slug}`), congelados al migrar a
/// `/{seccion}/{id}/{slug}`. Solo sirven para redirigir enlaces ya difundidos:
/// no se agregan filas nuevas y un slug nunca se reasigna a otra instancia.
model ConsultationLegacySlug {
  slug           String   @id @db.VarChar(191)
  consultationId Int
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
}

model ConsultationRelatedLink {
  id             Int      @id @default(autoincrement())
  consultationId Int
  label          String
  url            String   @db.Text
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, displayOrder])
}